{
  "name": "onefinance",
  "productName": "OneFinance",
  "version": "2.0.0",
  "description": "A local-first personal finance management cross-platform desktop application.",
  "author": {
    "name": "OneFinance Team",
    "email": "onefinanceteam@outlook.com"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/HarshPanchal01/OneFinance.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/HarshPanchal01/OneFinance/issues"
  },
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "vite",
    "build": "vue-tsc && vite build && electron-builder",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .vue,.js,.ts,.tsx",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:mac": "npm run build -- --mac -p never",
    "dist:win": "npm run build -- --win -p never",
    "dist:linux": "npm run build -- --linux -p never",
    "dist:all": "npm run build -- -mwl -p never"
  },
  "dependencies": {
    "@primevue/themes": "^4.5.4",
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "chart.js": "^4.5.1",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "yahoo-finance2": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^9.6.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.39",
    "autoprefixer": "^10.5.4",
    "electron": "^39.8.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.10.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vitest": "^4.1.11",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "tough-cookie": "^4.1.3",
    "form-data": "^4.0.0",
    "qs": "^6.14.1",
    "tar": "^7.5.11",
    "file-type": "^21.3.1",
    "@tootallnate/once": "^3.0.1",
    "phin": "^3.7.1",
    "yargs-parser": "^21.1.1"
  },
  "main": "dist-electron/main.js"
}
